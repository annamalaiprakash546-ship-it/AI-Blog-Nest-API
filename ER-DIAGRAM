erDiagram

    USER ||--o{ BLOG : creates
    BLOG ||--o{ COMMENT : receives
    USER ||--o{ COMMENT : writes
    BLOG ||--o{ BLOG_TAG : has
    TAG ||--o{ BLOG_TAG : contains

    USER {
        ObjectId _id PK
        string name
        string email UK
        string password
        string role
        datetime createdAt
        datetime updatedAt
    }

    BLOG {
        ObjectId _id PK
        ObjectId authorId FK
        string title
        string topic
        text content
        string status
        datetime createdAt
        datetime updatedAt
    }

    COMMENT {
        ObjectId _id PK
        ObjectId blogId FK
        ObjectId userId FK
        text content
        datetime createdAt
        datetime updatedAt
    }

    TAG {
        ObjectId _id PK
        string name UK
    }

    BLOG_TAG {
        ObjectId blogId FK
        ObjectId tagId FK
    }

