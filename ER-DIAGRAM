models/BlogTag.js
const mongoose = require("mongoose");

const blogTagSchema = new mongoose.Schema(
  {
    blogId: {
      type: mongoose.Schema.Types.ObjectId,
      ref: "Blog",
      required: true
    },

    tagId: {
      type: mongoose.Schema.Types.ObjectId,
      ref: "Tag",
      required: true
    }
  },
  {
    timestamps: true
  }
);

blogTagSchema.index(
  { blogId: 1, tagId: 1 },
  { unique: true }
);

module.exports = mongoose.model("BlogTag", blogTagSchema);

