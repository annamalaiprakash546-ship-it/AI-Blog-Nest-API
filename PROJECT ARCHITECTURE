5. models/Blog.js
const mongoose = require("mongoose");

const blogSchema = new mongoose.Schema(
  {
    title: {
      type: String,
      required: true,
      trim: true
    },

    topic: {
      type: String,
      required: true,
      trim: true
    },

    content: {
      type: String,
      required: true
    },

    author: {
      type: String,
      default: "AI BlogNest"
    },

    tags: {
      type: [String],
      default: []
    },

    status: {
      type: String,
      enum: ["draft", "published"],
      default: "draft"
    }
  },
  {
    timestamps: true
  }
);

module.exports = mongoose.model("Blog", blogSchema);

6. services/aiService.js
const generateBlog = async (topic) => {
  if (!topic) {
    throw new Error("Topic is required");
  }

  // Replace this section with your preferred AI provider.
  const title = `Complete Guide to ${topic}`;

  const content = `
# ${title}

## Introduction

${topic} is an important and interesting subject. This article
provides an overview of ${topic}, its benefits, applications,
and important considerations.

## What is ${topic}?

${topic} refers to a concept that can be explored from different
technical and practical perspectives.

## Benefits

- Easy to understand
- Useful in real-world applications
- Can improve productivity
- Provides opportunities for innovation

## Conclusion

${topic} continues to be an important area of interest.
Understanding its concepts and applications can help users
make better technical and practical decisions.
`;

  return {
    title,
    content,
    tags: [topic, "technology", "AI", "blog"]
  };
};

module.exports = {
  generateBlog
};

7. controllers/blogController.js
const Blog = require("../models/Blog");
const { generateBlog } = require("../services/aiService");

// Get all blogs
const getBlogs = async (req, res) => {
  try {
    const blogs = await Blog.find().sort({ createdAt: -1 });

    res.status(200).json({
      success: true,
      count: blogs.length,
      data: blogs
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: error.message
    });
  }
};

// Get one blog
const getBlog = async (req, res) => {
  try {
    const blog = await Blog.findById(req.params.id);

    if (!blog) {
      return res.status(404).json({
        success: false,
        message: "Blog not found"
      });
    }

    res.status(200).json({
      success: true,
      data: blog
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: error.message
    });
  }
};

// Generate AI blog
const generateAIBlog = async (req, res) => {
  try {
    const { topic } = req.body;

    if (!topic) {
      return res.status(400).json({
        success: false,
        message: "Topic is required"
      });
    }

    const generatedBlog = await generateBlog(topic);

    const blog = await Blog.create({
      title: generatedBlog.title,
      topic,
      content: generatedBlog.content,
      tags: generatedBlog.tags
    });

    res.status(201).json({
      success: true,
      message: "AI blog generated successfully",
      data: blog
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: error.message
    });
  }
};

// Update blog
const updateBlog = async (req, res) => {
  try {
    const blog = await Blog.findByIdAndUpdate(
      req.params.id,
      req.body,
      {
        new: true,
        runValidators: true
      }
    );

    if (!blog) {
      return res.status(404).json({
        success: false,
        message: "Blog not found"
      });
    }

    res.status(200).json({
      success: true,
      data: blog
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: error.message
    });
  }
};

// Delete blog
const deleteBlog = async (req, res) => {
  try {
    const blog = await Blog.findByIdAndDelete(req.params.id);

    if (!blog) {
      return res.status(404).json({
        success: false,
        message: "Blog not found"
      });
    }

    res.status(200).json({
      success: true,
      message: "Blog deleted successfully"
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: error.message
    });
  }
};

module.exports = {
  getBlogs,
  getBlog,
  generateAIBlog,
  updateBlog,
  deleteBlog
};

8. routes/blogRoutes.js
const express = require("express");

const {
  getBlogs,
  getBlog,
  generateAIBlog,
  updateBlog,
  deleteBlog
} = require("../controllers/blogController");

const router = express.Router();

router.get("/", getBlogs);
router.get("/:id", getBlog);
router.post("/generate", generateAIBlog);
router.put("/:id", updateBlog);
router.delete("/:id", deleteBlog);

module.exports = router;

9. server.js
require("dotenv").config();

const express = require("express");
const cors = require("cors");

const connectDB = require("./config/db");
const blogRoutes = require("./routes/blogRoutes");

const app = express();

connectDB();

app.use(cors());
app.use(express.json());

app.get("/", (req, res) => {
  res.json({
    success: true,
    message: "Welcome to AI BlogNest API"
  });
});

app.use("/api/blogs", blogRoutes);

const PORT = process.env.PORT || 5000;

app.listen(PORT, () => {
  console.log(`AI BlogNest API running on port ${PORT}`);
});

API endpoints
Method	Endpoint	Purpose
GET	/	API status
GET	/api/blogs	Get all blogs
GET	/api/blogs/:id	Get one blog
POST	/api/blogs/generate	Generate an AI blog
PUT	/api/blogs/:id	Update blog
DELETE	/api/blogs/:id	Delete blog

